# Старий адрес artbudtrading.com.ua/calculator/ (калькулятор переїхав на roofkit.com.ua)
Options -Indexes
Options -MultiViews
RewriteEngine On
RewriteBase /calculator/

# Службові файли (паролі, бібліотеки) — заборонено
RewriteRule (^|/)\.env - [F,L]
RewriteRule (^|/)\.ftp-deploy - [F,L]
RewriteRule ^(vendor|src)/ - [F,L]

# Калькулятор переїхав: усе перенаправляємо на roofkit.com.ua з тим самим шляхом
RewriteRule ^api/(.*)$ https://roofkit.com.ua/api/$1 [R=308,L]
RewriteRule ^(.*)$ https://roofkit.com.ua/$1 [R=301,L]
